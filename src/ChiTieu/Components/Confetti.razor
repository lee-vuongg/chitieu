@using System.Globalization

@* Confetti thuần CSS: mỗi mảnh giấy là một thẻ <i> với biến CSS ngẫu nhiên, hoạt cảnh nằm trong hieu-ung.css. *@
@if (Hien)
{
    <div class="confetti" aria-hidden="true">
        @foreach (var p in _manh)
        {
            <i style="--x:@(p.X)%;--w:@(p.W)px;--c:@p.Mau;--t:@N(p.Giay)s;--d:@N(p.Tre)s;--dx:@(p.Dx)vw;--rot:@(p.Quay)deg"></i>
        }
    </div>
}

@code {
    [Parameter] public bool Hien { get; set; }

    private record Manh(int X, int W, string Mau, double Giay, double Tre, int Dx, int Quay);
    private static readonly string[] Mau = { "#F2B01E", "#2FBF71", "#E2552B", "#4C8DF6", "#E25BA8", "#FFFDF8" };
    private List<Manh> _manh = new();

    protected override void OnParametersSet()
    {
        if (Hien && _manh.Count == 0)
        {
            var r = new Random();
            for (var i = 0; i < 70; i++)
                _manh.Add(new Manh(r.Next(0, 100), r.Next(6, 12), Mau[r.Next(Mau.Length)],
                    2.6 + r.NextDouble() * 2, r.NextDouble() * 0.9, r.Next(-20, 21), r.Next(240, 900)));
        }
        else if (!Hien) _manh.Clear();
    }

    private static string N(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);
}
