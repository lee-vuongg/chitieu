@* Trạng thái rỗng: minh họa SVG nhẹ + câu hướng dẫn thân thiện. *@
<div class="rong-khung lan-luot">
    <svg viewBox="0 0 160 120" fill="none" aria-hidden="true">
        @switch (Kieu)
        {
            case "ngan-sach":
                <circle cx="80" cy="62" r="42" fill="var(--the-2)" stroke="var(--vien)" stroke-width="2" />
                <path d="M80 62V20a42 42 0 0 1 36 62z" fill="var(--vang-dam)" />
                <path d="M80 62L116 83a42 42 0 0 1-72 4z" fill="var(--thu)" opacity=".8" />
                <circle cx="80" cy="62" r="14" fill="var(--the)" />
                break;
            case "muc-tieu":
                <ellipse cx="80" cy="104" rx="46" ry="8" fill="var(--the-2)" />
                <path d="M60 100V22" stroke="var(--chu-phu)" stroke-width="5" stroke-linecap="round" />
                <path d="M62 24h46l-12 15 12 15H62z" fill="var(--thu)" />
                <circle cx="60" cy="20" r="6" fill="var(--vang-dam)" />
                break;
            default:
                <rect x="38" y="12" width="84" height="96" rx="14" fill="var(--the-2)" stroke="var(--vien)" stroke-width="2" />
                <rect x="52" y="30" width="46" height="7" rx="3.5" fill="var(--chu-phu)" opacity=".35" />
                <rect x="52" y="46" width="32" height="7" rx="3.5" fill="var(--chu-phu)" opacity=".25" />
                <rect x="52" y="62" width="40" height="7" rx="3.5" fill="var(--chu-phu)" opacity=".2" />
                <circle cx="112" cy="88" r="20" fill="var(--vang-dam)" />
                @((MarkupString)"<text x=\"112\" y=\"96\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"800\" fill=\"#1D2430\">đ</text>")
                break;
        }
    </svg>
    <h3>@Tieu</h3>
    <p>@Mo</p>
    @ChildContent
</div>

@code {
    /// <summary>giao-dich | ngan-sach | muc-tieu</summary>
    [Parameter] public string Kieu { get; set; } = "giao-dich";
    [Parameter] public string Tieu { get; set; } = "";
    [Parameter] public string Mo { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}