@page "/"
@inherits TrangCoSoDuLieu
@inject ThongKeService ThongKe
@inject QuanLyNganSach NganSachQL
@inject BackupService Backup
@inject AiService Ai
@inject GiaoDichService GD
@inject SheetService Sheet
@inject NavigationManager Nav

<PageTitle>Tổng quan · Chi tiêu</PageTitle>

@{
    var hn = Dong.HomNay;
    var laThangNay = _nam == hn.Year && _thang == hn.Month;
    var tq = ThongKe.TongQuan(Kho.DsGiaoDich, _nam, _thang);
    var coDuLieuThang = Kho.DsGiaoDich.Any(g => g.Ngay.Year == _nam && g.Ngay.Month == _thang);
    var canhBao = laThangNay ? NganSachQL.CanhBaoThangNay() : new List<CanhBaoNganSach>();
    var ganDay = Kho.DsGiaoDich.OrderByDescending(g => g.Ngay).ThenByDescending(g => g.TaoLuc).Take(5).ToList();
}

<div class="trang">
    <div class="dau-trang">
        <div>
            <div class="phu">Xin chào 👋</div>
            <h1>Tổng quan</h1>
        </div>
    </div>

    <div class="the" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 10px">
        <button type="button" class="nut nut-tron" aria-label="Tháng trước" @onclick="ThangTruoc">‹</button>
        <b style="font-size:19px">@DinhDang.Thang(_nam, _thang)</b>
        <button type="button" class="nut nut-tron" aria-label="Tháng sau" disabled="@laThangNay" @onclick="ThangSau">›</button>
    </div>

    @if (Backup.CanNhac)
    {
        <div class="canh-bao vang lan-luot" role="status">
            <span class="bieu-tuong" aria-hidden="true">💾</span>
            <div style="flex:1">
                <b>Nên sao lưu dữ liệu</b>
                @(Backup.SoNgayTuLanCuoi == null ? "Bạn chưa sao lưu lần nào." : $"Đã {Backup.SoNgayTuLanCuoi} ngày chưa sao lưu.")
                <div style="margin-top:10px"><button type="button" class="nut nut-nho nut-chinh" @onclick="@(() => Nav.NavigateTo("cai-dat"))">Sao lưu ngay</button></div>
            </div>
        </div>
    }

    @foreach (var c in canhBao)
    {
        <CanhBaoCard CB="c" />
    }

    @if (Kho.DsGiaoDich.Count == 0)
    {
        <EmptyState Kieu="giao-dich" Tieu="Chào mừng đến sổ chi tiêu" Mo="Bấm nút + ở giữa, gõ “ăn phở 50k” rồi bấm Lưu. Chỉ một bước là xong.">
            <button type="button" class="nut nut-chinh" @onclick="Sheet.MoMoi">Thêm khoản đầu tiên</button>
        </EmptyState>
    }
    else
    {
        <section class="the-tong lan-luot" style="--i:0" aria-label="Tổng thu chi tháng">
            <span class="nhan-nho">Còn lại trong tháng</span>
            <SoTien Gia="@tq.ConLai" Class="so so-khong-lo" />
            <div class="thu-chi">
                <div><span class="nhan-nho">Thu</span><SoTien Gia="@tq.Thu" Class="so mui-thu" /></div>
                <div><span class="nhan-nho">Chi</span><SoTien Gia="@tq.Chi" Class="so mui-chi" /></div>
            </div>
        </section>

        @if (coDuLieuThang)
        {
            <div class="the lan-luot" style="--i:1">
                <div class="the-tieu-de"><h2>So với tháng trước</h2></div>
                @if (tq.ThayDoiSoVoiThangTruoc is double pt)
                {
                    var rong = Math.Abs(pt) < 0.005;
                    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                        <span class="huy-hieu @(rong ? "vang" : pt > 0 ? "chi" : "thu")" style="font-size:20px">
                            @(rong ? "＝ Bằng tháng trước" : pt > 0 ? "▲ Chi tăng " + DinhDang.PhanTram(pt) : "▼ Chi giảm " + DinhDang.PhanTram(-pt))
                        </span>
                        <span class="chu-phu">Tháng trước chi @DinhDang.Tien(tq.ChiThangTruoc)</span>
                    </div>
                }
                else
                {
                    <p class="chu-phu">Tháng trước chưa có khoản chi nào để so sánh.</p>
                }
            </div>

            <div class="the lan-luot" style="--i:2">
                <div class="the-tieu-de"><h2>Chi theo danh mục</h2></div>
                @if (tq.Chi == 0)
                {
                    <p class="chu-phu">Tháng này chưa có khoản chi.</p>
                }
                else
                {
                    <DonutChart Mieng="MiengDonuts(tq)" NhanGiua="Tổng chi" SoGiua="@tq.Chi" />
                }
            </div>

            <div class="the lan-luot" style="--i:3">
                <div class="the-tieu-de"><h2>Chi theo ngày</h2></div>
                <CotChart Gia="tq.ChiTheoNgay" Thang="@_thang" HomNay="@(laThangNay ? hn.Day : 0)" />
            </div>
        }
        else
        {
            <EmptyState Kieu="giao-dich" Tieu="Tháng này chưa có gì" Mo="Chưa có khoản thu chi nào trong tháng này." />
        }

        @if (Ai.DaCauHinh)
        {
            <div class="the lan-luot" style="--i:4">
                <div class="the-tieu-de"><h2>Hỏi trợ lý AI</h2></div>
                <div class="truong">
                    <input class="o-nhap" type="text" placeholder="Ví dụ: tuần rồi tiêu bao nhiêu tiền xăng?" aria-label="Câu hỏi cho AI"
                           enterkeyhint="send" @bind="_cauHoi" @bind:event="oninput" @onkeydown="PhimHoi" />
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button type="button" class="nut nut-chinh" disabled="@(_dangAi || string.IsNullOrWhiteSpace(_cauHoi))" @onclick="HoiAi">Hỏi</button>
                        <button type="button" class="nut" disabled="@_dangAi" @onclick="TongKetAi">Tổng kết tháng bằng AI</button>
                    </div>
                    <span class="tro-giup">Chỉ gửi số liệu tổng hợp theo ngày và danh mục, không gửi ghi chú của bạn.</span>
                </div>
                @if (_dangAi)
                {
                    <div class="skeleton sk-dong" style="margin-top:12px" aria-busy="true"></div>
                }
                @if (!string.IsNullOrEmpty(_traLoiAi))
                {
                    <div class="xem-truoc lan-luot" style="margin-top:12px" role="status">
                        <b>Trợ lý AI</b>
                        <div style="white-space:pre-wrap">@_traLoiAi</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_loiAi))
                {
                    <p class="loi" style="margin-top:10px" role="alert">@_loiAi</p>
                }
            </div>
        }

        @if (ganDay.Count > 0)
        {
            <div class="nhom-ngay">
                <div class="tieu-de-ngay"><span>Gần đây</span><a href="lich-su" style="font-weight:700">Xem tất cả</a></div>
                @{ var stt = 0; }
                @foreach (var g in ganDay)
                {
                    <HangGiaoDich @key="g.Id" G="g" Stt="@(stt++)" MoNgay="true" OnSua="Sua" OnXoa="Xoa" DangXoa="@_dangXoa.Contains(g.Id)" />
                }
            </div>
        }
    }
</div>

@code {
    private int _nam, _thang;
    private string _cauHoi = "";
    private string? _traLoiAi, _loiAi;
    private bool _dangAi;
    private readonly HashSet<Guid> _dangXoa = new();

    protected override void KhoiTao()
    {
        var hn = Dong.HomNay;
        _nam = hn.Year; _thang = hn.Month;
    }

    private void ThangTruoc()
    {
        var d = new DateOnly(_nam, _thang, 1).AddMonths(-1);
        _nam = d.Year; _thang = d.Month; _traLoiAi = null; _loiAi = null;
    }

    private void ThangSau()
    {
        var d = new DateOnly(_nam, _thang, 1).AddMonths(1);
        _nam = d.Year; _thang = d.Month; _traLoiAi = null; _loiAi = null;
    }

    /// <summary>Lấy 5 danh mục chi lớn nhất, phần còn lại gộp thành một miếng "Còn lại" cho biểu đồ dễ đọc.</summary>
    private List<DonutChart.MiengDonut> MiengDonuts(TongQuanThang tq)
    {
        var kq = new List<DonutChart.MiengDonut>();
        foreach (var d in tq.ChiTheoDanhMuc.Take(5))
        {
            var dm = Kho.TimDanhMuc(d.DanhMucId);
            kq.Add(new DonutChart.MiengDonut(dm?.Ten ?? "Khác", dm?.Mau ?? "#9AA0A6", d.SoTien, d.TyLe));
        }
        var con = tq.ChiTheoDanhMuc.Skip(5).ToList();
        if (con.Count > 0)
            kq.Add(new DonutChart.MiengDonut("Còn lại", "#9AA0A6", con.Sum(x => x.SoTien), con.Sum(x => x.TyLe)));
        return kq;
    }

    private Task Sua(GiaoDich g) { Sheet.MoSua(g); return Task.CompletedTask; }

    private async Task Xoa(GiaoDich g)
    {
        if (!_dangXoa.Add(g.Id)) return;
        await Rung.RungAsync(15);
        await Task.Delay(260);
        await AnToanAsync(async () =>
        {
            var daXoa = await GD.XoaAsync(g.Id);
            if (daXoa != null) Bao.DaXoa(daXoa);
        });
        _dangXoa.Remove(g.Id);
    }

    private async Task PhimHoi(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_dangAi && !string.IsNullOrWhiteSpace(_cauHoi)) await HoiAi();
    }

    private async Task HoiAi()
    {
        _dangAi = true; _traLoiAi = null; _loiAi = null;
        try
        {
            var r = await Ai.HoiAsync(_cauHoi.Trim());
            if (r.Ok) _traLoiAi = r.Data; else _loiAi = r.Loi;
        }
        finally { _dangAi = false; }
    }

    private async Task TongKetAi()
    {
        _dangAi = true; _traLoiAi = null; _loiAi = null;
        try
        {
            var r = await Ai.TongKetThangAsync(_nam, _thang);
            if (r.Ok) _traLoiAi = r.Data; else _loiAi = r.Loi;
        }
        finally { _dangAi = false; }
    }
}
