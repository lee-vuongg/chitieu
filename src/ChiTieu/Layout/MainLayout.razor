@inherits LayoutComponentBase
@implements IDisposable
@inject KhoDuLieu Kho
@inject CaiDatService CaiDat
@inject DongHo Dong
@inject SheetService Sheet

<MudThemeProvider Theme="_theme" IsDarkMode="@CaiDat.DangToi" />
<MudPopoverProvider />
<MudSnackbarProvider />

@if (!Kho.DaTai)
{
    @* Skeleton trong lúc đọc dữ liệu từ IndexedDB *@
    <div class="trang" aria-busy="true" aria-label="Đang tải dữ liệu">
        <div class="skeleton" style="height:34px;width:60%"></div>
        <div class="skeleton sk-the"></div>
        <div class="skeleton sk-dong"></div>
        <div class="skeleton sk-dong"></div>
        <div class="skeleton sk-dong"></div>
    </div>
}
else if (Kho.Loi != null)
{
    <div class="loi-khung" role="alert">
        <h2>Chưa mở được dữ liệu</h2>
        <p>@Kho.Loi</p>
        <button type="button" class="nut nut-chinh" @onclick="ThuLai">Thử lại</button>
    </div>
}
else
{
    <main class="noi-dung">@Body</main>
    <ThanhDieuHuong />
    <button type="button" class="nut-them" aria-label="Thêm khoản chi hoặc thu mới" @onclick="Sheet.MoMoi">+</button>
    <NhapNhanhSheet />
    <HuongDanIos />
}

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1D2430",
            Background = "#F4F0E6",
            Surface = "#FFFDF8",
            TextPrimary = "#1D2430",
            Success = "#17803F",
            Warning = "#F2B01E",
            Error = "#D0312B"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#F1EEE6",
            Background = "#12161B",
            Surface = "#1B2128",
            TextPrimary = "#F1EEE6",
            Success = "#4CD187",
            Warning = "#F2B01E",
            Error = "#FF6B63"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Kho.ThayDoi += Doi;
        CaiDat.GiaoDienDoi += Doi;
        Sheet.Doi += Doi;

        await Dong.KhoiTaoAsync();     // lấy múi giờ trình duyệt để "hôm nay" đúng
        await Kho.TaiAsync();          // đọc IndexedDB
        await CaiDat.KhoiTaoGiaoDienAsync(); // áp dụng sáng/tối
    }

    private async Task ThuLai()
    {
        await Kho.TaiAsync();
        await CaiDat.KhoiTaoGiaoDienAsync();
    }

    private void Doi() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Kho.ThayDoi -= Doi;
        CaiDat.GiaoDienDoi -= Doi;
        Sheet.Doi -= Doi;
    }
}
